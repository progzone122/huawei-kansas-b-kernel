  y_max_mt = <1560>;
  flip_x = <1>;
  flip_y = <1>;


  power_self_ctrl = <1>;
  ts-kit-iovdd-type = <1>;
  ts-kit-vcc-type = <1>;
  ts-kit-iovdd-value = <1800000>;
  ts-kit-vcc-value = <3000000>;
  vddio_default_on = <1>;
  ts-kit-iovdd-supply = <&mt_pmic_vs1_buck_reg>;
  ts-kit-vcc-supply = <&mt_pmic_vldo28_ldo_reg>;

  slave_address = <0x14>;
