  get_brightness_info_flag = <0>;
  has_virtualkey = <0>;
  lcd_full = <0>;
  provide_panel_id_support = <1>;
  chip_id = <0x54>;
  hard_reset_delay = <200>;
  erase_min_delay = <1350>;
  calc_crc_delay = <300>;
