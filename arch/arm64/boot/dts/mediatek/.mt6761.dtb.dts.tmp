  mediatek,clkbuf-config = <2 1 1 2 0 0 0>;
  mediatek,clkbuf-driving-current = <1 1 1 1 1 1 1>;
 };
 pseudo_m4u {
  compatible = "mediatek,mt-pseudo_m4u";
  iommus = <&iommu (((0) << 5) | (2))>;
 };

 pseudo_m4u-larb0 {
  compatible = "mediatek,mt-pseudo_m4u-port";
  mediatek,larbid = <0>;
  iommus = <&iommu (((0) << 5) | (0))>,
    <&iommu (((0) << 5) | (1))>,
    <&iommu (((0) << 5) | (2))>,
    <&iommu (((0) << 5) | (3))>,
    <&iommu (((0) << 5) | (4))>,
    <&iommu (((0) << 5) | (5))>,
    <&iommu (((0) << 5) | (6))>,
    <&iommu (((0) << 5) | (7))>;
 };

 pseudo_m4u-larb1 {
  compatible = "mediatek,mt-pseudo_m4u-port";
  mediatek,larbid = <1>;
  iommus = <&iommu (((1) << 5) | (0))>,
    <&iommu (((1) << 5) | (1))>;
 };

 pseudo_m4u-larb2 {
  compatible = "mediatek,mt-pseudo_m4u-port";
  mediatek,larbid = <2>;
  iommus = <&iommu (((2) << 5) | (0))>,
    <&iommu (((2) << 5) | (1))>;
 };

 radio_md_cfg: radio_md_cfg {
  compatible = "mediatek,radio_md_cfg";
 };

 dynamic_options: dynamic_options {
