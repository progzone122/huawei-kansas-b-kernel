 firmware {
  android {
   compatible = "android,firmware";

   vbmeta {
    compatible = "android,vbmeta";




    parts = "vbmeta,boot,system,vendor,odm,version,product,eng_vendor,eng_system,preload,cust";
# 2822 "arch/arm64/boot/dts/mediatek/mt6761.dts"
   };


   fstab {
    compatible = "android,fstab";
# 2845 "arch/arm64/boot/dts/mediatek/mt6761.dts"
    vendor {
     compatible = "android,vendor";
     dev = "/dev/block/platform/bootdevice/by-name/vendor";
     type = "erofs";
     mnt_flags = "ro";



     fsmgr_flags = "wait,avb";
# 2871 "arch/arm64/boot/dts/mediatek/mt6761.dts"
    };



    odm {
     compatible = "android,odm";
     dev = "/dev/block/platform/bootdevice/by-name/odm";
     type = "erofs";
     mnt_flags = "ro";



     fsmgr_flags = "wait,avb";
# 2901 "arch/arm64/boot/dts/mediatek/mt6761.dts"
    };

   };
  };
 };


