  compatible = "mediatek,mt635x-auxadc";
  #io-channel-cells = <1>;

  batadc {
   channel = <0x00>;
   resistance-ratio = <3 1>;
   avg-num = <128>;
  };
  isense {
   channel = <0x01>;
   resistance-ratio = <3 1>;
   avg-num = <128>;
  };
